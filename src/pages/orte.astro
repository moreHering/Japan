---
/**
 * Orte & Karte.
 *
 * Die Seite ist bewusst nackt: Titel, Insel, fertig. Hier standen bis zum
 * 21.09.2026 ein Untertitel und ein aufklappbarer Erklärkasten („Woher die
 * Zahlen kommen"). Beides ist raus, weil es die Seite sperrig gemacht hat —
 * Nachschlagetext, den man einmal liest und danach wegklickt, kostet auf einem
 * 390-px-Schirm jeden Tag Platz.
 *
 * Mit dem Kasten ist auch der Verweis auf die ursprüngliche
 * `Japan-Karte-2026.kml` verschwunden. Das ist kein Versehen: Die Datei, die der
 * Knopf in der Insel erzeugt, enthält alles, was die alte enthält, **plus** eure
 * Korrekturen und eigenen Orte. Die alte liegt weiter unter
 * `/Japan/Japan-Karte-2026.kml`, falls sie je gebraucht wird.
 */
import Base from '../layouts/Base.astro';
import PlaceExplorer from '../components/PlaceExplorer.svelte';
import { places } from '../lib/places';
---

<Base title="Orte & Karte">
  <PlaceExplorer client:only="svelte" places={places} />
</Base>
