---
import Base from '../layouts/Base.astro';
import TripStatus from '../components/TripStatus.svelte';
import { places } from '../lib/places';
import { stations, trip, formatDay } from '../lib/trip';
import { url, guide } from '../lib/paths';
import chapters from '../data/chapters.json';
// Beide Dateien erzeugt `npm run data` aus der Lesefassung. Als Rohtext geladen,
// damit der Band hier im Planer gelesen wird und nicht nur verlinkt ist.
import bandInhalt from '../data/reiseband-inhalt.html?raw';
import bandStil from '../data/reiseband-stil.css?raw';

/** Orte je Station, getrennt nach Zentrum und Ausflügen. */
const countsOf = (slug: string) => ({
  zentrum: places.filter((p) => p.station === slug && p.area === 'zentrum').length,
  ausflug: places.filter((p) => p.station === slug && p.area === 'ausflug').length,
});

/**
 * Die elf Kapitel des Reisebands, für den Leseblock unten.
 *
 * `chapters.json` erzeugt `npm run data` aus der Lesefassung selbst — von Hand
 * gepflegt wäre die Liste nach der ersten Textänderung falsch, und eine
 * Kapitelübersicht, die auf etwas anderes zeigt als sie behauptet, ist
 * schlimmer als keine.
 *
 * Die sechs Stationskapitel bekommen ihre harten Zahlen dazu: Nächte, Datum,
 * Ortsanzahl. Das steht in stations.json und nicht im Band.
 */
const kapitel = chapters.map((k) => {
  const s = stations.find((x) => x.slug === k.id);
  if (!s) return { ...k, station: null, orte: 0 };
  const c = countsOf(s.slug);
  return { ...k, station: s, orte: c.zentrum + c.ausflug };
});

/** Anker im Reiseband — vom Konvertierungsskript gesetzt. */
const chapterOf: Record<string, string> = {
  osaka: 'osaka',
  kyoto: 'kyoto',
  kanazawa: 'kanazawa',
  takayama: 'takayama',
  hakone: 'hakone',
  tokio: 'tokio',
};
---

<Base title="Übersicht">
  <!--
    Hier stand ein Hero-Block mit Titel, japanischem Schriftzug und dem großen
    旅. Er ist weg, weil der Band **seine eigene Titelseite** mitbringt — mit
    genau denselben Elementen, von dort hatte ich sie ursprünglich abgeschaut.
    Zweimal derselbe Deckel kostete 298 px, bevor überhaupt ein Satz kam.
  -->
  <TripStatus client:only="svelte" />

  <!--
    Der Reiseband, vollständig und direkt lesbar.

    Vorher stand hier eine Kachelliste, die man erst anklicken musste, um zum
    Text zu kommen — ein Umweg, für den es keinen Grund gab. Die 137 kB Text
    sind gzip-komprimiert etwa 59 kB; das ist weniger als ein einzelnes Foto,
    meine frühere Warnung davor war übertrieben.

    Die Sprungmarken darüber sind bewusst eine schmale Zeile und keine Kacheln:
    Bei elf Kapiteln braucht man einen Weg, mittendrin anzufangen — aber der Text
    ist die Hauptsache und beginnt direkt darunter.
  -->
  <nav class="bandsprung" aria-label="Kapitel">
    <span class="bandsprung-titel">Kapitel</span>
    {
      kapitel.map((k) => (
        <a href={`#${k.id}`}>{k.station ? k.station.name : k.rubrik.split(' · ')[0]}</a>
      ))
    }
  </nav>

  <div class="bandtext" set:html={bandInhalt} />

  <!--
    Ein Ankersprung muss die Klappe öffnen.

    Der Band ist seit dem Umbau ein Akkordeon, und die Anker sitzen an den
    `<details>`. Ein Link wie `/Japan/#kyoto` aus `paths.ts:kapitel()` springt
    sonst an eine **zugeklappte** Zeile: Man landet richtig und sieht nichts, und
    hält den Link für kaputt. Das ist der einzige Grund für dieses Skript.

    Zwei Fälle, beide nötig: beim Laden mit Anker (`hashchange` feuert dann
    nicht) und bei jedem Sprung danach. `scrollIntoView` erst **nach** dem
    Öffnen — vorher steht die Klappe noch an ihrer alten Höhe, und der Browser
    scrollt an die falsche Stelle.
  -->
  <script is:inline>
    (function () {
      function aufklappen() {
        var id = location.hash.slice(1);
        if (!id) return;
        var ziel = document.getElementById(id);
        if (!ziel) return;
        // Auch die Eltern öffnen: Ein Anker kann in einem Teilabschnitt liegen.
        var k = ziel;
        while (k) {
          if (k.tagName === 'DETAILS') k.open = true;
          k = k.parentElement;
        }
        ziel.scrollIntoView();
      }
      window.addEventListener('hashchange', aufklappen);
      aufklappen();
    })();
  </script>

  <p class="banddruck">
    <!--
      Steht hinter dem Text, nicht davor: Eine Fußnote, die 80 px Vorlauf kostet,
      bevor der erste Satz kommt, ist an der falschen Stelle.

      Die Datei reiseband.html bleibt ein geschlossenes Dokument zum Ausdrucken
      oder Weitergeben, mit den Seitenrändern, die hier wegfallen. Ohne diesen
      Verweis wäre sie von nirgends mehr erreichbar.
    -->
    Zum Ausdrucken oder Weitergeben:
    <a href={guide()}>der Band als eigenes Dokument</a>. Die sieben Empfehlungen
    ohne Nummer stehen nur darin und nicht auf der Karte — Gion ehrlich, Nijō-jō,
    Tsukiji-Außenmarkt, 21st Century Museum, Shinhotaka-Seilbahn, Igelcafé, Round1.
  </p>

  <!-- ------------------------------------------------------------ Stationen -->
  <section class="section">
    <div class="eyebrow">Die Route</div>
    <h2>Sechs Stationen, {trip.nights} Nächte</h2>

    <div class="stations">
      {
        stations.map((s) => {
          const c = countsOf(s.slug);
          return (
            <article class="station">
              <div class="sno">
                {s.no}
                <span class="skanji">{s.kanji}</span>
              </div>
              <div class="sbody">
                <h3>
                  {s.name} <span class="sjp">{s.jp}</span>
                </h3>
                <p class="sclaim">{s.claim}</p>
                <div class="sfacts">
                  <span class="badge">
                    <b>{s.nights}</b> {s.nights === 1 ? 'Nacht' : 'Nächte'}
                  </span>
                  <span class="badge">
                    {formatDay(s.from)} – {formatDay(s.to)}
                  </span>
                  <span class="badge">
                    <b>{c.zentrum}</b> im Zentrum
                  </span>
                  {c.ausflug > 0 && (
                    <span class="badge">
                      <b>{c.ausflug}</b> Ausflüge
                    </span>
                  )}
                </div>
                <p class="sstay">{s.stay}</p>
                <div class="slinks">
                  <a href={`${url('orte')}?station=${s.slug}`}>Orte ansehen</a>
                  <a href={`#${chapterOf[s.slug]}`}>Kapitel lesen</a>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <!--
    Das Stylesheet des Bandes, an `.bandtext` gebunden. Muss `is:global` sein:
    Astro bindet Stile sonst an Elemente, die es selbst erzeugt hat — der Inhalt
    kommt hier über `set:html` und wäre damit unformatiert.

    Gebunden wird beim Erzeugen (`scripts/css-scope.mjs`), nicht hier: Das CSS
    führt `:root`, `html`, `body`, `.eyebrow` und `.wrap`, und unverändert
    eingebunden würde es die ganze Anwendung umlackieren. `npm run data` bricht
    ab, wenn eine Regel ohne Container übrig bleibt.
  -->
  <style is:global set:html={bandStil}></style>

  <style>
    /* ------------------------------------------------------- Kapitelsprünge */

    /*
     * Eine Zeile, seitlich wischbar — nicht umbrechend.
     *
     * Umbrechend waren es 144 px, also ein Fünftel des Bildschirms, nur für
     * Sprungmarken. Der Text ist die Hauptsache; die Marken sind der Notausgang
     * für „ich will bei Kyoto weiterlesen".
     */
    .bandsprung {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: 12px;
      align-items: center;
      margin: 14px 0 6px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--line);
    }
    .bandsprung::-webkit-scrollbar {
      display: none;
    }
    .bandsprung > * {
      flex: none;
      white-space: nowrap;
    }
    .bandsprung-titel {
      font-family: var(--util);
      font-size: 0.66rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ai-40);
    }
    .bandsprung a {
      font-family: var(--util);
      font-size: 0.78rem;
      color: var(--ai-60);
      text-decoration: none;
      border-bottom: 1px solid var(--line);
      /* Schmale Zeile, aber ein Finger muss die Marke treffen. */
      padding: 9px 2px;
    }
    .bandsprung a:hover,
    .bandsprung a:focus-visible {
      color: var(--shu);
      border-color: var(--shu);
    }

    /* --------------------------------------------------------- Der Bandtext */

    .banddruck {
      margin: 10px 0 22px;
      font-size: 0.78rem;
      line-height: 1.6;
      color: var(--ai-60);
    }
    .banddruck a {
      color: var(--shu);
    }

    .bandtext {
      /* Der Band bringt seine eigene Breite und Typografie mit; hier wird nur
         dafür gesorgt, dass er nicht aus der Seite läuft. */
      max-width: 100%;
      overflow-wrap: break-word;
    }
    /* Die Anker sitzen an den Kapiteln. Ohne Abstand verschwindet die
       Überschrift beim Sprung unter die feste Kopfzeile.

       `details[id]` und nicht mehr `section[id]`: Seit der Band ein Akkordeon
       ist, trägt die Klappe den Anker. Der alte Selektor blieb gültiges CSS und
       traf nichts — die Art Regel, die man erst bemerkt, wenn eine Überschrift
       unter der Kopfzeile steckt. */
    .bandtext :global(details[id]) {
      scroll-margin-top: 70px;
    }
    /* Der Scrollrahmen um jede Tabelle — sonst schiebt die breiteste die ganze
       Seite zur Seite. Gesetzt wird er beim Erzeugen der Lesefassung. */
    .bandtext :global(.bandtabelle) {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      max-width: 100%;
    }

    /* -------------------------------------------------------------- Abschnitte */

    .section {
      margin-top: 40px;
    }

    .section h2 {
      font-size: clamp(1.5rem, 3.8vw, 2rem);
      margin-bottom: 16px;
    }

    /* --------------------------------------------------------------- Stationen */

    .stations {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
      gap: 12px;
    }

    .station {
      display: flex;
      gap: 15px;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 15px 17px 16px;
    }

    .sno {
      font-family: var(--disp);
      font-weight: 700;
      font-size: 1.85rem;
      color: var(--shu);
      line-height: 1;
      flex: none;
      text-align: center;
    }

    .skanji {
      display: block;
      font-family: var(--jp);
      font-size: 1.05rem;
      color: var(--kin);
      margin-top: 6px;
      opacity: 0.85;
    }

    .sbody {
      min-width: 0;
      flex: 1;
    }

    .station h3 {
      font-size: 1.16rem;
      display: flex;
      align-items: baseline;
      gap: 8px;
      flex-wrap: wrap;
    }

    .sjp {
      font-family: var(--jp);
      font-size: 0.82rem;
      color: var(--shu-deep);
      letter-spacing: 0.14em;
    }

    .sclaim {
      font-style: italic;
      color: var(--ai-60);
      font-size: 0.9rem;
      margin: 2px 0 9px;
    }

    .sfacts {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      margin-bottom: 9px;
    }

    .sstay {
      font-family: var(--util);
      font-size: 0.74rem;
      color: var(--ai-40);
      margin: 0 0 9px;
      line-height: 1.45;
    }

    .slinks {
      display: flex;
      gap: 14px;
      font-family: var(--util);
      font-size: 0.74rem;
    }

    @media (max-width: 767px) {
      /* Die Stationslinks sind eigenständige Ziele, keine Fließtextlinks —
         auf dem Handy brauchen sie eine Fläche, die sich sicher treffen lässt. */
      .slinks {
        gap: 8px;
        margin-top: 4px;
      }
      .slinks a {
        flex: 1;
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--washi-2);
        border: 1px solid var(--line);
        border-radius: var(--radius-sm);
        padding: 0 10px;
        text-align: center;
      }
      .slinks a:hover {
        text-decoration: none;
      }

      .station {
        gap: 12px;
        padding: 14px 14px 15px;
      }}</style>
</Base>
