---
import Base from '../layouts/Base.astro';
import Freundebuch from '../components/Freundebuch.svelte';
---

<Base title="Freundebuch">
  <Freundebuch client:only="svelte" />
</Base>

<!--
  Die Seite bricht mit der Gestaltung des Reiseplaners — das ist der Zweck.
  Hintergrund und Schrift werden deshalb global überschrieben, aber nur auf
  dieser Seite: Kopf- und Navigationsleiste bleiben, wie sie überall sind,
  damit man von hier ohne Umweg zurückkommt.
-->
<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DotGothic16&display=swap');

  body {
    background:
      radial-gradient(circle at 20% 0%, rgba(255, 79, 163, 0.18), transparent 45%),
      radial-gradient(circle at 80% 12%, rgba(53, 224, 232, 0.18), transparent 40%),
      /* Karo wie die Kachelhintergründe der alten Homepages */
      repeating-linear-gradient(0deg, rgba(123, 92, 255, 0.07) 0 1px, transparent 1px 22px),
      repeating-linear-gradient(90deg, rgba(123, 92, 255, 0.07) 0 1px, transparent 1px 22px),
      #f4eefb;
  }

  main#main {
    padding-top: 10px;
  }

  /* Der Fuß des Reiseplaners passt hier nicht — das Buch hat einen eigenen. */
  body > footer {
    display: none;
  }
</style>
