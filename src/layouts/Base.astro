---
import '../styles/tokens.css';
import { url, guide } from '../lib/paths';
import trip from '../data/trip.json';

interface Props {
  title: string;
  /** Kurzer Untertitel in der Kopfzeile. */
  subtitle?: string;
  /** Seite füllt die Höhe selbst (Kartenansicht) — kein Innenabstand, kein Footer. */
  full?: boolean;
}

const { title, subtitle, full = false } = Astro.props;

const nav = [
  { href: url(), label: 'Übersicht', match: '' },
  { href: url('plan'), label: 'Tagesplan', match: 'plan' },
  { href: url('orte'), label: 'Orte', match: 'orte' },
  { href: url('karte'), label: 'Karte', match: 'karte' },
  { href: url('organisation'), label: 'Organisation', match: 'organisation' },
];

// Aktiven Navigationspunkt aus dem Pfad ableiten, ohne den base-Präfix.
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL, '').replace(/\/$/, '');
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${trip.title} — Reiseplan, Orte und Karte`} />
    <meta name="theme-color" content="#16233C" />
    <title>{title} · {trip.title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Spectral:ital,wght@0,400;0,600;1,400&family=Zen+Kaku+Gothic+New:wght@400;500;700&family=Noto+Serif+JP:wght@500;700&display=swap"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%2316233C'/%3E%3Ccircle cx='16' cy='16' r='8' fill='%23C6402B'/%3E%3C/svg%3E"
    />
  </head>

  <body class={full ? 'is-full' : ''}>
    <a class="skip" href="#main">Zum Inhalt springen</a>

    <header class="nav">
      <a class="brand" href={url()}>
        <span class="brand-jp">旅</span>
        <span class="brand-text">
          <b>{trip.title}</b>
          <small>26.09.–15.10.</small>
        </span>
      </a>

      <nav aria-label="Hauptnavigation">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={path === item.match ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="sep">
            <a href={guide()}>Reiseband</a>
          </li>
        </ul>
      </nav>
    </header>

    {
      subtitle && (
        <div class="pagehead">
          <div class="inner">
            <h1>{title}</h1>
            <p>{subtitle}</p>
          </div>
        </div>
      )
    }

    <main id="main" class={full ? 'full' : 'inner'}>
      <slot />
    </main>

    {
      !full && (
        <footer>
          <div class="inner">
            <p>
              Der Reiseplan liegt in diesem Browser. Über <a href={url('organisation')}>Organisation</a>{' '}
              exportierst du ihn als Datei, um ihn auf ein anderes Gerät zu bringen.
            </p>
            <p class="dim">
              164 Orte aus dem Reiseband · Karte: <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
            </p>
          </div>
        </footer>
      )
    }

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 200;
        background: var(--shu);
        color: #fff;
        padding: 10px 16px;
        font-family: var(--util);
        font-size: 0.8rem;
      }
      .skip:focus {
        left: 0;
      }

      .inner {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 16px;
      }

      /* ------------------------------------------------------------ Navigation */

      .nav {
        position: sticky;
        top: 0;
        z-index: 100;
        min-height: var(--nav-h);
        background: var(--ai);
        color: var(--washi);
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 0 16px;
        flex-wrap: wrap;
        box-shadow: 0 1px 0 rgba(166, 124, 51, 0.35);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--washi);
        padding: 8px 0;
        flex: none;
      }
      .brand:hover {
        text-decoration: none;
      }
      .brand-jp {
        font-family: var(--jp);
        font-size: 1.32rem;
        color: var(--shu);
        line-height: 1;
      }
      .brand-text {
        display: flex;
        flex-direction: column;
        line-height: 1.15;
      }
      .brand-text b {
        font-family: var(--disp);
        font-weight: 600;
        font-size: 0.98rem;
      }
      .brand-text small {
        font-family: var(--util);
        font-size: 0.6rem;
        letter-spacing: 0.14em;
        color: var(--kin-soft);
      }

      .nav nav {
        flex: 1;
        min-width: 0;
      }
      .nav ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        gap: 2px;
        overflow-x: auto;
        scrollbar-width: none;
      }
      .nav ul::-webkit-scrollbar {
        display: none;
      }
      .nav a {
        display: block;
        font-family: var(--util);
        font-size: 0.78rem;
        letter-spacing: 0.04em;
        color: #c4bba6;
        padding: 9px 12px;
        border-radius: var(--radius-sm);
        white-space: nowrap;
      }
      .nav a:hover {
        color: var(--washi);
        background: rgba(255, 255, 255, 0.07);
        text-decoration: none;
      }
      .nav a[aria-current='page'] {
        color: var(--washi);
        background: rgba(198, 64, 43, 0.9);
      }
      .nav .sep {
        margin-left: auto;
      }
      .nav .sep a {
        color: var(--kin-soft);
        border: 1px solid rgba(166, 124, 51, 0.5);
      }

      /* ------------------------------------------------------------- Seitenkopf */

      .pagehead {
        background: linear-gradient(150deg, var(--ai-900), var(--ai) 70%, #1c2f4f);
        color: var(--washi);
        padding: 30px 0 26px;
      }
      .pagehead h1 {
        font-size: clamp(1.7rem, 4.6vw, 2.5rem);
        color: var(--washi);
      }
      .pagehead p {
        margin: 8px 0 0;
        max-width: 62ch;
        color: #cdc4b0;
        font-size: 0.98rem;
      }

      main {
        padding-top: 26px;
        padding-bottom: 46px;
        min-height: 50vh;
      }
      main.full {
        padding: 0;
        min-height: 0;
      }

      body.is-full {
        overflow: hidden;
      }

      footer {
        border-top: 1px solid var(--line);
        padding: 22px 0 34px;
        font-size: 0.84rem;
        color: var(--ai-60);
      }
      footer p {
        margin: 0 0 5px;
        max-width: 70ch;
      }
      footer .dim {
        color: var(--ai-40);
        font-size: 0.78rem;
      }

      @media (max-width: 620px) {
        .nav {
          gap: 10px;
          padding: 0 12px;
        }
        .nav .sep {
          margin-left: 0;
        }
        .inner {
          padding: 0 14px;
        }
        .pagehead {
          padding: 22px 0 20px;
        }
      }
    </style>
  </body>
</html>
