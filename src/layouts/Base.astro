---
import '../styles/tokens.css';
import { url, asset } from '../lib/paths';
import trip from '../data/trip.json';
import SyncBadge from '../components/SyncBadge.svelte';

interface Props {
  title: string;
  /** Kurzer Untertitel in der Kopfzeile. */
  subtitle?: string;
  /** Seite füllt die Höhe selbst (Kartenansicht) — kein Innenabstand, kein Footer. */
  full?: boolean;
}

const { title, subtitle, full = false } = Astro.props;

/**
 * Die Hauptziele. Auf dem Handy sind sie die feste Leiste am unteren Rand —
 * dort, wo der Daumen hinreicht. Am Rechner stehen sie oben.
 * Die Symbole sind Inline-SVG, damit keine Icon-Bibliothek geladen werden muss.
 */
const nav = [
  {
    href: url(),
    label: 'Übersicht',
    short: 'Start',
    match: '',
    icon: 'M3 11.5 12 4l9 7.5M5.5 10v9.5h13V10',
  },
  {
    href: url('plan'),
    label: 'Tagesplan',
    short: 'Plan',
    match: 'plan',
    icon: 'M4 6.5h16v14H4zM4 10.5h16M8.5 3.5v5M15.5 3.5v5',
  },
  {
    href: url('orte'),
    label: 'Orte & Karte',
    short: 'Orte',
    match: 'orte',
    icon: 'M3 6.5 9 4l6 2.5L21 4v13.5L15 20l-6-2.5L3 20zM9 4v13.5M15 6.5V20',
  },
  {
    href: url('organisation'),
    label: 'Organisation',
    short: 'Orga',
    match: 'organisation',
    icon: 'M5 4.5h14v15H5zM8.5 9h7M8.5 12.5h7M8.5 16h4',
  },
  {
    href: url('freundebuch'),
    label: 'Freundebuch',
    short: 'Freunde',
    match: 'freundebuch',
    icon: 'M12 20.5S4 15 4 10a4 4 0 0 1 8-2 4 4 0 0 1 8 2c0 5-8 10.5-8 10.5z',
  },
];

// Aktiven Punkt aus dem Pfad ableiten, ohne den base-Präfix.
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL, '').replace(/\/$/, '');
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={`${trip.title} — Reiseplan, Orte und Karte`} />
    <meta name="theme-color" content="#16233C" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={trip.title} />
    <title>{title} · {trip.title}</title>

    <link rel="manifest" href={asset('manifest.webmanifest')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Spectral:ital,wght@0,400;0,600;1,400&family=Zen+Kaku+Gothic+New:wght@400;500;700&family=Noto+Serif+JP:wght@500;700&display=swap"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%2316233C'/%3E%3Ccircle cx='16' cy='16' r='8' fill='%23C6402B'/%3E%3C/svg%3E"
    />
  </head>

  <body class={full ? 'is-full' : ''}>
    <a class="skip" href="#main">Zum Inhalt springen</a>

    <header class="topbar">
      <a class="brand" href={url()}>
        <span class="brand-jp">旅</span>
        <span class="brand-text">
          <b>{trip.title}</b>
          <small>26.09.–15.10.</small>
        </span>
      </a>

      <!-- Am Rechner die vollständige Navigation, auf dem Handy nur der Reiseband-Link -->
      <nav class="topnav" aria-label="Hauptnavigation">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={path === item.match ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Startet den Abgleich und zeigt seinen Zustand — auf jeder Seite. -->
      <SyncBadge client:load />

      <!--
        Führt zur Startseite, nicht mehr zur Datei reiseband.html: Der Text steht
        jetzt dort. Auf die Datei zu zeigen hieße, in einer zweiten Kopie
        desselben Texts zu landen — ohne Navigation und ohne Tageszählung.
      -->
      <a class="bookmark" href={url('')}>
        <span aria-hidden="true">📖</span>
        <span class="bookmark-text">Reiseband</span>
      </a>
    </header>

    {
      subtitle && (
        <div class="pagehead">
          <div class="inner">
            <h1>{title}</h1>
            <p>{subtitle}</p>
          </div>
        </div>
      )
    }

    <main id="main" class={full ? 'full' : 'inner'}>
      <slot />
    </main>


    <!-- Feste Leiste am unteren Rand — nur auf dem Handy sichtbar -->
    <nav class="tabbar" aria-label="Hauptnavigation">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={path === item.match ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={item.icon} />
            </svg>
            <span>{item.short}</span>
          </a>
        ))
      }
    </nav>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 200;
        background: var(--shu);
        color: #fff;
        padding: 10px 16px;
        font-family: var(--util);
        font-size: 0.8rem;
      }
      .skip:focus {
        left: 0;
      }

      .inner {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 var(--seitenrand);
      }

      /* ---------------------------------------------------------- Kopfleiste */

      .topbar {
        position: sticky;
        top: 0;
        z-index: 100;
        min-height: var(--nav-h);
        background: var(--ai);
        color: var(--washi);
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 0 var(--seitenrand);
        padding-top: env(safe-area-inset-top);
        box-shadow: 0 1px 0 rgba(166, 124, 51, 0.35);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--washi);
        padding: 8px 0;
        min-width: 0;
        /* Schiebt Abzeichen und Lesezeichen nach rechts, auch wenn die
           Hauptnavigation auf dem Handy ausgeblendet ist. */
        margin-right: auto;
        flex: none;
      }
      .brand:hover {
        text-decoration: none;
      }
      .brand-jp {
        font-family: var(--jp);
        font-size: 1.32rem;
        color: var(--shu);
        line-height: 1;
      }
      .brand-text {
        display: flex;
        flex-direction: column;
        line-height: 1.15;
      }
      .brand-text b {
        font-family: var(--disp);
        font-weight: 600;
        font-size: 0.98rem;
      }
      .brand-text small {
        font-family: var(--util);
        font-size: 0.6rem;
        letter-spacing: 0.14em;
        color: var(--kin-soft);
      }

      .topnav {
        flex: 1;
        min-width: 0;
      }
      .topnav ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        gap: 2px;
      }
      .topnav a {
        display: block;
        font-family: var(--util);
        font-size: 0.78rem;
        letter-spacing: 0.04em;
        color: #c4bba6;
        padding: 9px 12px;
        border-radius: var(--radius-sm);
        white-space: nowrap;
      }
      .topnav a:hover {
        color: var(--washi);
        background: rgba(255, 255, 255, 0.07);
        text-decoration: none;
      }
      .topnav a[aria-current='page'] {
        color: var(--washi);
        background: rgba(198, 64, 43, 0.9);
      }

      .bookmark {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        flex: none;
        font-family: var(--util);
        font-size: 0.75rem;
        color: var(--kin-soft);
        border: 1px solid rgba(166, 124, 51, 0.5);
        border-radius: 999px;
        padding: 8px 14px;
        min-height: 38px;
      }
      .bookmark:hover {
        text-decoration: none;
        background: rgba(255, 255, 255, 0.07);
        color: var(--washi);
      }

      /* --------------------------------------------------------- Seitenkopf */

      .pagehead {
        background: linear-gradient(150deg, var(--ai-900), var(--ai) 70%, #1c2f4f);
        color: var(--washi);
        padding: 30px 0 26px;
      }
      .pagehead h1 {
        font-size: clamp(1.7rem, 4.6vw, 2.5rem);
        color: var(--washi);
      }
      .pagehead p {
        margin: 8px 0 0;
        max-width: 62ch;
        color: #cdc4b0;
        font-size: 0.98rem;
      }

      main {
        padding-top: 26px;
        padding-bottom: 46px;
        min-height: 40svh;
      }
      main.full {
        padding: 0;
        min-height: 0;
      }

      body.is-full {
        overflow: hidden;
      }

      /* ------------------------------------------------- Leiste am Fußrand */

      .tabbar {
        display: none;
      }

      /* ------------------------------------------------------------- Handy */

      @media (max-width: 767px) {
        /* Die Navigation wandert nach unten in Daumenreichweite; oben bleibt
           nur Titel und Reiseband-Verweis. */
        .topnav {
          display: none;
        }

        .topbar {
          gap: 10px;
          padding: 0 12px;
          padding-top: env(safe-area-inset-top);
          min-height: var(--nav-h-mobile);
          justify-content: space-between;
        }

        .brand-text b {
          font-size: 0.92rem;
        }

        .bookmark {
          padding: 7px 12px;
        }
        .bookmark-text {
          display: none;
        }

        .tabbar {
          position: fixed;
          left: 0;
          right: 0;
          bottom: 0;
          z-index: 120;
          display: flex;
          background: var(--ai);
          border-top: 1px solid rgba(166, 124, 51, 0.4);
          padding-bottom: env(safe-area-inset-bottom);
        }

        .tabbar a {
          flex: 1;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          gap: 3px;
          /* 44 px ist das Mindestmaß, unter dem Tippen unzuverlässig wird. */
          min-height: 52px;
          padding: 7px 2px 6px;
          color: #9aa2b2;
          font-family: var(--util);
          font-size: 0.62rem;
          letter-spacing: 0.04em;
          text-decoration: none;
          -webkit-tap-highlight-color: transparent;
        }

        .tabbar svg {
          width: 22px;
          height: 22px;
          fill: none;
          stroke: currentColor;
          stroke-width: 1.6;
          stroke-linecap: round;
          stroke-linejoin: round;
        }

        .tabbar a[aria-current='page'] {
          color: var(--washi);
        }
        .tabbar a[aria-current='page'] svg {
          stroke: var(--shu);
          stroke-width: 2;
        }
        .tabbar a:active {
          background: rgba(255, 255, 255, 0.06);
        }

        /* Platz schaffen, damit die Leiste nichts verdeckt. */
        main:not(.full) {
          padding-bottom: calc(var(--tabbar-h) + 20px);
        }

        /* Auf schmalen Schirmen bis an den Rand statt zentrierter Spalte. */
        .inner {
          padding: 0 var(--seitenrand);
        }
        .pagehead {
          padding: 16px 0 14px;
        }
        .pagehead h1 {
          font-size: 1.45rem;
        }
        /* Der erläuternde Satz ist auf dem kleinen Schirm teuer erkaufter
           Platz — zwei Zeilen genügen, der Rest steht ohnehin im Reiseband. */
        .pagehead p {
          font-size: 0.86rem;
          line-height: 1.45;
          display: -webkit-box;
          -webkit-line-clamp: 2;
          line-clamp: 2;
          -webkit-box-orient: vertical;
          overflow: hidden;
        }
        main {
          padding-top: 18px;
        }
      }

      @media (max-width: 400px) {
        .brand-text small {
          display: none;
        }
        .tabbar a {
          font-size: 0.58rem;
        }
      }
    </style>
  </body>
</html>
