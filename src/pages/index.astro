---
import Base from '../layouts/Base.astro';
import TripStatus from '../components/TripStatus.svelte';
import { places, alleOrte, CATEGORIES } from '../lib/places';
import { legs, stations, trip, formatDay } from '../lib/trip';
import { url, guide, asset } from '../lib/paths';
import chapters from '../data/chapters.json';
// Beide Dateien erzeugt `npm run data` aus der Lesefassung. Als Rohtext geladen,
// damit der Band hier im Planer gelesen wird und nicht nur verlinkt ist.
import bandInhalt from '../data/reiseband-inhalt.html?raw';
import bandStil from '../data/reiseband-stil.css?raw';

/** Orte je Station, getrennt nach Zentrum und Ausflügen. */
const countsOf = (slug: string) => ({
  zentrum: places.filter((p) => p.station === slug && p.area === 'zentrum').length,
  ausflug: places.filter((p) => p.station === slug && p.area === 'ausflug').length,
});

const catCounts = CATEGORIES.map((c) => ({
  ...c,
  count: places.filter((p) => p.category === c.key).length,
}));

const friendTips = places.filter((p) => p.isFriendTip);
/** Vorschläge des Reisebands, die durch die Buchungen erledigt sind. */
const erledigteUnterkuenfte = alleOrte.filter((p) => p.uebernachtung === 'vorschlag').length;
const bookingPlaces = places.filter((p) => p.needsBooking).length;
const closedPlaces = places.filter((p) => p.closedDay).length;
/** Manche Orte haben beides — deshalb zählen, nicht addieren. */
const trickyPlaces = places.filter((p) => p.needsBooking || p.closedDay).length;

/**
 * Die elf Kapitel des Reisebands, für den Leseblock unten.
 *
 * `chapters.json` erzeugt `npm run data` aus der Lesefassung selbst — von Hand
 * gepflegt wäre die Liste nach der ersten Textänderung falsch, und eine
 * Kapitelübersicht, die auf etwas anderes zeigt als sie behauptet, ist
 * schlimmer als keine.
 *
 * Die sechs Stationskapitel bekommen ihre harten Zahlen dazu: Nächte, Datum,
 * Ortsanzahl. Das steht in stations.json und nicht im Band.
 */
const kapitel = chapters.map((k) => {
  const s = stations.find((x) => x.slug === k.id);
  if (!s) return { ...k, station: null, orte: 0 };
  const c = countsOf(s.slug);
  return { ...k, station: s, orte: c.zentrum + c.ausflug };
});

/** Anker im Reiseband — vom Konvertierungsskript gesetzt. */
const chapterOf: Record<string, string> = {
  osaka: 'osaka',
  kyoto: 'kyoto',
  kanazawa: 'kanazawa',
  takayama: 'takayama',
  hakone: 'hakone',
  tokio: 'tokio',
};
---

<Base title="Übersicht">
  <!--
    Hier stand ein Hero-Block mit Titel, japanischem Schriftzug und dem großen
    旅. Er ist weg, weil der Band **seine eigene Titelseite** mitbringt — mit
    genau denselben Elementen, von dort hatte ich sie ursprünglich abgeschaut.
    Zweimal derselbe Deckel kostete 298 px, bevor überhaupt ein Satz kam.
  -->
  <TripStatus client:only="svelte" />

  <!--
    Der Reiseband, vollständig und direkt lesbar.

    Vorher stand hier eine Kachelliste, die man erst anklicken musste, um zum
    Text zu kommen — ein Umweg, für den es keinen Grund gab. Die 137 kB Text
    sind gzip-komprimiert etwa 59 kB; das ist weniger als ein einzelnes Foto,
    meine frühere Warnung davor war übertrieben.

    Die Sprungmarken darüber sind bewusst eine schmale Zeile und keine Kacheln:
    Bei elf Kapiteln braucht man einen Weg, mittendrin anzufangen — aber der Text
    ist die Hauptsache und beginnt direkt darunter.
  -->
  <nav class="bandsprung" aria-label="Kapitel">
    <span class="bandsprung-titel">Kapitel</span>
    {
      kapitel.map((k) => (
        <a href={`#${k.id}`}>{k.station ? k.station.name : k.rubrik.split(' · ')[0]}</a>
      ))
    }
  </nav>

  <div class="bandtext" set:html={bandInhalt} />

  <p class="banddruck">
    <!--
      Steht hinter dem Text, nicht davor: Eine Fußnote, die 80 px Vorlauf kostet,
      bevor der erste Satz kommt, ist an der falschen Stelle.

      Die Datei reiseband.html bleibt ein geschlossenes Dokument zum Ausdrucken
      oder Weitergeben, mit den Seitenrändern, die hier wegfallen. Ohne diesen
      Verweis wäre sie von nirgends mehr erreichbar.
    -->
    Zum Ausdrucken oder Weitergeben:
    <a href={guide()}>der Band als eigenes Dokument</a>. Die sieben Empfehlungen
    ohne Nummer stehen nur darin und nicht auf der Karte — Gion ehrlich, Nijō-jō,
    Tsukiji-Außenmarkt, 21st Century Museum, Shinhotaka-Seilbahn, Igelcafé, Round1.
  </p>

  <!-- ------------------------------------------------------------ Stationen -->
  <section class="section">
    <div class="eyebrow">Die Route</div>
    <h2>Sechs Stationen, {trip.nights} Nächte</h2>

    <div class="stations">
      {
        stations.map((s) => {
          const c = countsOf(s.slug);
          return (
            <article class="station">
              <div class="sno">
                {s.no}
                <span class="skanji">{s.kanji}</span>
              </div>
              <div class="sbody">
                <h3>
                  {s.name} <span class="sjp">{s.jp}</span>
                </h3>
                <p class="sclaim">{s.claim}</p>
                <div class="sfacts">
                  <span class="badge">
                    <b>{s.nights}</b> {s.nights === 1 ? 'Nacht' : 'Nächte'}
                  </span>
                  <span class="badge">
                    {formatDay(s.from)} – {formatDay(s.to)}
                  </span>
                  <span class="badge">
                    <b>{c.zentrum}</b> im Zentrum
                  </span>
                  {c.ausflug > 0 && (
                    <span class="badge">
                      <b>{c.ausflug}</b> Ausflüge
                    </span>
                  )}
                </div>
                <p class="sstay">{s.stay}</p>
                <div class="slinks">
                  <a href={`${url('orte')}?station=${s.slug}`}>Orte ansehen</a>
                  <a href={`#${chapterOf[s.slug]}`}>Kapitel lesen</a>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <!-- -------------------------------------------------------------- Etappen -->
  <section class="section">
    <div class="eyebrow">Umzugstage</div>
    <h2>Fünf Etappen</h2>

    <div class="legs">
      {
        legs.map((l) => (
          <div class="leg">
            <div class="legdate">{formatDay(l.date)}</div>
            <div class="legroute">
              <b>{l.from}</b> <span class="arrow">→</span> <b>{l.to}</b>
            </div>
            <div class="legconn">{l.connection}</div>
            <div class="legdur">{l.duration}</div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ----------------------------------------------------------- Orte-Zahlen -->
  <section class="section">
    <div class="eyebrow">Was auf der Karte liegt</div>
    <h2>{places.length} Orte, fünf Kategorien</h2>

    <div class="cats">
      {
        catCounts.map((c) => (
          <a class="cat" href={url('orte')} style={`--c:${c.color}`}>
            <b>{c.count}</b>
            <span>{c.short}</span>
          </a>
        ))
      }
    </div>

    <div class="notes">
      <div class="note">
        <h4>★ {friendTips.length} Freundestipps</h4>
        <p>{friendTips.map((p) => p.name).join(' · ')}</p>
      </div>
      <div class="note">
        <h4>Achtung bei {trickyPlaces} Orten</h4>
        <p>
          {closedPlaces} haben einen festen Schließtag, {bookingPlaces} brauchen eine Reservierung.
          Der <a href={url('plan')}>Tagesplan</a> warnt, wenn ein geschlossener Ort auf dem falschen
          Wochentag liegt; die offenen Reservierungen stehen in der <a
            href={url('organisation')}>Organisation</a
          >.
        </p>
      </div>
      <div class="note">
        <h4>Unterkünfte stehen</h4>
        <p>
          Für alle sechs Stationen ist etwas gebucht. Die {erledigteUnterkuenfte} Ryokan- und
          Tempelvorschläge des Reisebands sind deshalb aus Liste, Karte und Planer genommen — sie
          stehen weiter im gedruckten Band, falls doch etwas platzt.
        </p>
      </div>
      <div class="note">
        <h4>Nummern wie im Buch</h4>
        <p>
          Jeder Ort trägt dieselbe Nummer wie im Reiseband — von 1 in Osaka bis 164 in Tokio.
          Selbst ergänzte zählen ab 165 weiter, damit die gedruckten Nummern gültig bleiben.
          Die <a href={asset(trip.kmlFile)} download>KML-Datei</a> lässt sich zusätzlich in Google
          Maps laden.
        </p>
      </div>
    </div>
  </section>

  <!--
    Das Stylesheet des Bandes, an `.bandtext` gebunden. Muss `is:global` sein:
    Astro bindet Stile sonst an Elemente, die es selbst erzeugt hat — der Inhalt
    kommt hier über `set:html` und wäre damit unformatiert.

    Gebunden wird beim Erzeugen (`scripts/css-scope.mjs`), nicht hier: Das CSS
    führt `:root`, `html`, `body`, `.eyebrow` und `.wrap`, und unverändert
    eingebunden würde es die ganze Anwendung umlackieren. `npm run data` bricht
    ab, wenn eine Regel ohne Container übrig bleibt.
  -->
  <style is:global set:html={bandStil}></style>

  <style>
    /* ------------------------------------------------------- Kapitelsprünge */

    /*
     * Eine Zeile, seitlich wischbar — nicht umbrechend.
     *
     * Umbrechend waren es 144 px, also ein Fünftel des Bildschirms, nur für
     * Sprungmarken. Der Text ist die Hauptsache; die Marken sind der Notausgang
     * für „ich will bei Kyoto weiterlesen".
     */
    .bandsprung {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: 12px;
      align-items: center;
      margin: 14px 0 6px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--line);
    }
    .bandsprung::-webkit-scrollbar {
      display: none;
    }
    .bandsprung > * {
      flex: none;
      white-space: nowrap;
    }
    .bandsprung-titel {
      font-family: var(--util);
      font-size: 0.66rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ai-40);
    }
    .bandsprung a {
      font-family: var(--util);
      font-size: 0.78rem;
      color: var(--ai-60);
      text-decoration: none;
      border-bottom: 1px solid var(--line);
      /* Schmale Zeile, aber ein Finger muss die Marke treffen. */
      padding: 9px 2px;
    }
    .bandsprung a:hover,
    .bandsprung a:focus-visible {
      color: var(--shu);
      border-color: var(--shu);
    }

    /* --------------------------------------------------------- Der Bandtext */

    .banddruck {
      margin: 10px 0 22px;
      font-size: 0.78rem;
      line-height: 1.6;
      color: var(--ai-60);
    }
    .banddruck a {
      color: var(--shu);
    }

    .bandtext {
      /* Der Band bringt seine eigene Breite und Typografie mit; hier wird nur
         dafür gesorgt, dass er nicht aus der Seite läuft. */
      max-width: 100%;
      overflow-wrap: break-word;
    }
    /* Die Anker sitzen an den Kapiteln. Ohne Abstand verschwindet die
       Überschrift beim Sprung unter die feste Kopfzeile. */
    .bandtext :global(section[id]) {
      scroll-margin-top: 70px;
    }
    /* Der Scrollrahmen um jede Tabelle — sonst schiebt die breiteste die ganze
       Seite zur Seite. Gesetzt wird er beim Erzeugen der Lesefassung. */
    .bandtext :global(.bandtabelle) {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      max-width: 100%;
    }

    /* ------------------------------------------------------------------ Hero */

    .hero {
      position: relative;
      background: linear-gradient(155deg, var(--ai-900), var(--ai) 64%, #1c2f4f);
      color: var(--washi);
      border-radius: var(--radius);
      padding: 40px 30px 36px;
      overflow: hidden;
      margin-bottom: 18px;
    }

    .herotext {
      position: relative;
      z-index: 2;
      max-width: 640px;
    }

    .cover-eyebrow {
      font-family: var(--util);
      font-weight: 500;
      letter-spacing: 0.36em;
      text-transform: uppercase;
      font-size: 0.64rem;
      color: var(--kin-soft);
      margin-bottom: 18px;
    }

    .hero h1 {
      font-size: clamp(2.1rem, 6.4vw, 3.6rem);
      line-height: 1;
      color: var(--washi);
      letter-spacing: -0.02em;
    }

    .hero h1 .accent {
      color: var(--kin-soft);
      font-style: italic;
    }

    .jp-title {
      font-family: var(--jp);
      font-weight: 500;
      font-size: clamp(1.05rem, 3vw, 1.5rem);
      color: var(--shu);
      letter-spacing: 0.3em;
      margin: 14px 0 0;
      opacity: 0.93;
    }

    .sub {
      max-width: 54ch;
      margin: 18px 0 0;
      font-size: 1rem;
      color: #cdc4b0;
      line-height: 1.65;
    }

    .bigk {
      position: absolute;
      right: 2%;
      bottom: -14%;
      font-family: var(--jp);
      font-weight: 700;
      font-size: clamp(9rem, 26vw, 17rem);
      line-height: 1;
      color: var(--washi);
      opacity: 0.07;
      z-index: 1;
      user-select: none;
    }

    /* -------------------------------------------------------------- Abschnitte */

    .section {
      margin-top: 40px;
    }

    .section h2 {
      font-size: clamp(1.5rem, 3.8vw, 2rem);
      margin-bottom: 16px;
    }

    /* --------------------------------------------------------------- Stationen */

    .stations {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
      gap: 12px;
    }

    .station {
      display: flex;
      gap: 15px;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 15px 17px 16px;
    }

    .sno {
      font-family: var(--disp);
      font-weight: 700;
      font-size: 1.85rem;
      color: var(--shu);
      line-height: 1;
      flex: none;
      text-align: center;
    }

    .skanji {
      display: block;
      font-family: var(--jp);
      font-size: 1.05rem;
      color: var(--kin);
      margin-top: 6px;
      opacity: 0.85;
    }

    .sbody {
      min-width: 0;
      flex: 1;
    }

    .station h3 {
      font-size: 1.16rem;
      display: flex;
      align-items: baseline;
      gap: 8px;
      flex-wrap: wrap;
    }

    .sjp {
      font-family: var(--jp);
      font-size: 0.82rem;
      color: var(--shu-deep);
      letter-spacing: 0.14em;
    }

    .sclaim {
      font-style: italic;
      color: var(--ai-60);
      font-size: 0.9rem;
      margin: 2px 0 9px;
    }

    .sfacts {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      margin-bottom: 9px;
    }

    .sstay {
      font-family: var(--util);
      font-size: 0.74rem;
      color: var(--ai-40);
      margin: 0 0 9px;
      line-height: 1.45;
    }

    .slinks {
      display: flex;
      gap: 14px;
      font-family: var(--util);
      font-size: 0.74rem;
    }

    /* -------------------------------------------------------------- Reiseband */

    .bandlead {
      max-width: 62ch;
      margin: 0 0 18px;
      color: var(--ai-60);
      line-height: 1.6;
    }
    .bandlead a {
      color: var(--shu);
      font-weight: 600;
      white-space: nowrap;
    }

    .kapitel {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 8px;
      /* Zwei Spalten, sobald Platz ist. Auf dem Handy eine — elf Kapitel
         nebeneinander gequetscht liest niemand. */
      grid-template-columns: 1fr;
      counter-reset: kap;
    }
    @media (min-width: 720px) {
      .kapitel {
        grid-template-columns: 1fr 1fr;
      }
    }

    .kap a {
      display: block;
      /* 52 px hoch durch das Innenmaß — jedes Kapitel ist ein Tippziel. */
      padding: 12px 14px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--washi);
      text-decoration: none;
      color: inherit;
      transition:
        border-color 0.15s,
        background 0.15s;
    }
    .kap a:hover,
    .kap a:focus-visible {
      border-color: var(--shu);
      background: #fff;
    }
    /* Die sechs Stationskapitel sind der Kern — sie bekommen die Zinnoberkante. */
    .kap.station a {
      border-left: 3px solid var(--shu);
    }

    .kaprubrik {
      display: block;
      font-family: var(--util);
      font-size: 0.66rem;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: var(--kin);
    }
    .kaptitel {
      display: block;
      font-family: var(--disp);
      font-size: 1rem;
      line-height: 1.3;
      margin-top: 3px;
    }
    .kapjp {
      display: block;
      font-family: var(--jp);
      font-size: 0.8rem;
      color: var(--ai-40);
      margin-top: 2px;
    }
    .kapfakten {
      display: block;
      font-size: 0.72rem;
      color: var(--ai-60);
      margin-top: 5px;
      font-variant-numeric: tabular-nums;
    }

    .bandfuss {
      max-width: 62ch;
      margin: 16px 0 0;
      font-size: 0.8rem;
      line-height: 1.6;
      color: var(--ai-60);
      border-left: 2px solid var(--line);
      padding-left: 12px;
    }

    /* ----------------------------------------------------------------- Etappen */

    .legs {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .leg {
      display: grid;
      grid-template-columns: 82px 190px 1fr auto;
      gap: 14px;
      align-items: baseline;
      background: var(--card);
      border: 1px solid var(--line);
      border-left: 4px solid var(--kin);
      border-radius: var(--radius-sm);
      padding: 10px 14px;
    }

    .legdate {
      font-family: var(--util);
      font-size: 0.74rem;
      font-weight: 700;
      color: var(--shu);
      letter-spacing: 0.03em;
    }

    .legroute b {
      font-family: var(--disp);
      font-weight: 600;
      font-size: 0.97rem;
    }

    .arrow {
      color: var(--kin);
      margin: 0 3px;
    }

    .legconn {
      font-size: 0.84rem;
      color: var(--ai-60);
    }

    .legdur {
      font-family: var(--util);
      font-size: 0.74rem;
      color: var(--ai-40);
      white-space: nowrap;
    }

    /* -------------------------------------------------------------- Kategorien */

    .cats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(118px, 1fr));
      gap: 9px;
      margin-bottom: 18px;
    }

    .cat {
      background: var(--card);
      border: 1px solid var(--line);
      border-top: 3px solid var(--c);
      border-radius: var(--radius-sm);
      padding: 13px 14px;
      color: var(--ai);
    }

    .cat:hover {
      text-decoration: none;
      background: var(--washi-2);
    }

    .cat b {
      display: block;
      font-family: var(--disp);
      font-size: 1.7rem;
      line-height: 1;
      color: var(--c);
    }

    .cat span {
      font-family: var(--util);
      font-size: 0.72rem;
      color: var(--ai-60);
      display: block;
      margin-top: 4px;
    }

    .notes {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 12px;
    }

    .note {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 14px 16px;
    }

    .note h4 {
      color: var(--shu);
      margin-bottom: 6px;
      font-size: 0.72rem;
      letter-spacing: 0.1em;
    }

    .note p {
      font-size: 0.85rem;
      color: var(--ai-60);
      margin: 0;
      line-height: 1.55;
    }

    @media (max-width: 767px) {
      /* Die Stationslinks sind eigenständige Ziele, keine Fließtextlinks —
         auf dem Handy brauchen sie eine Fläche, die sich sicher treffen lässt. */
      .slinks {
        gap: 8px;
        margin-top: 4px;
      }
      .slinks a {
        flex: 1;
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--washi-2);
        border: 1px solid var(--line);
        border-radius: var(--radius-sm);
        padding: 0 10px;
        text-align: center;
      }
      .slinks a:hover {
        text-decoration: none;
      }

      .station {
        gap: 12px;
        padding: 14px 14px 15px;
      }

      .cats {
        grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
      }
    }

    @media (max-width: 720px) {
      .hero {
        padding: 30px 20px 28px;
      }
      .leg {
        grid-template-columns: 1fr;
        gap: 3px;
      }
      .legdur {
        color: var(--ai-60);
      }
    }
  </style>
</Base>
