---
/**
 * Layout für die Gästeansicht — das Reisetagebuch unter /Japan/tagebuch/.
 *
 * Bewusst **nicht** `Base.astro` mit einem Schalter, sondern ein eigenes Layout.
 * Drei Dinge müssen hier fehlen, und jedes davon wäre in `Base.astro` eine
 * Bedingung, an der später etwas durchrutscht:
 *
 * 1. **Keine App-Navigation.** Ein Gast hat im Tagesplaner nichts zu suchen — die
 *    Seiten funktionieren ohne Anmeldung, zeigen dann aber leere Pläne, und das
 *    sieht nach einem Fehler aus. Dazu ist die Adresse absichtlich nicht verlinkt;
 *    eine Navigation, die zurück in die App führt, hebelt das aus.
 *
 * 2. **Kein `<SyncBadge client:load />`.** Das ist die einzige Stelle im Projekt,
 *    die `initAuth()` und `initSync()` startet. Öffnet ein Reisender die
 *    Gästeseite im angemeldeten Browser, würde sie sonst seinen Plan abgleichen —
 *    eine Leseansicht, die im Hintergrund schreibt.
 *
 * 3. **Kein Manifest.** Sonst legt ein Gast das Tagebuch als App ab und landet
 *    über dessen `start_url` im Planer.
 *
 * Was hier dagegen **sein muss**: `tokens.css`. Die Karte und die Leaflet-Popups
 * benutzen `--washi-2`, `--util`, `--ai-40`, `--shu` und `--radius`; ohne die
 * Tokens ist die Karte optisch kaputt. Die Y2K-Optik überschreibt danach — ihre
 * Regeln stehen alle unter `.y2k` und gewinnen über die Spezifität.
 */
import '../styles/tokens.css';
import trip from '../data/trip.json';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={`${trip.title} — das Reisetagebuch`} />

    <!--
      `noindex` ist eine Bitte an gutwillige Suchmaschinen, kein Schloss. Eine
      robots.txt lässt sich für diese Seite gar nicht setzen — sie müsste unter
      morehering.github.io/robots.txt liegen, also im Benutzer-Repository, nicht
      in diesem. Und Messenger holen sich beim Verschicken eines Links die Seite
      samt erstem Bild, ohne nach robots zu fragen.

      `noarchive` bittet zusätzlich darum, keine Kopie im Cache zu behalten.
    -->
    <meta name="robots" content="noindex, nofollow, noarchive" />

    <!-- Rosa statt Indigo: Das hier ist nicht der Planer. -->
    <meta name="theme-color" content="#ff4fa3" />
    <title>{title} · {trip.title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!--
      DotGothic16 ist die Y2K-Schrift, Zen Kaku Gothic New die Zweitschrift der
      `.y2k`-Regel. Spectral fehlt hier absichtlich — es ist die Leseschrift des
      Reisebands und kommt auf dieser Seite nicht vor.
    -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DotGothic16&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%232a1440'/%3E%3Ccircle cx='16' cy='16' r='8' fill='%23ff4fa3'/%3E%3C/svg%3E"
    />
  </head>

  <body class="gastseite">
    <a class="skip" href="#main">Zum Inhalt springen</a>

    <main id="main">
      <slot />
    </main>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 200;
        background: #ff4fa3;
        color: #2a1440;
        padding: 10px 16px;
        font-family: 'DotGothic16', monospace;
        font-size: 0.85rem;
      }
      .skip:focus {
        left: 0;
      }

      main {
        /* Schmaler als die 1180 px des Planers: Hier wird gelesen und geschaut,
           nicht in Tabellen gearbeitet. */
        max-width: 720px;
        margin: 0 auto;
        padding: 0 14px 40px;
      }
    </style>
  </body>
</html>
