---
import Base from '../layouts/Base.astro';
import TripStatus from '../components/TripStatus.svelte';
import { places } from '../lib/places';
import { stations, trip, formatDay } from '../lib/trip';
import { url, guide } from '../lib/paths';
// Beide Dateien erzeugt `npm run data` aus der Lesefassung. Als Rohtext geladen,
// damit der Band hier im Planer gelesen wird und nicht nur verlinkt ist.
import bandInhalt from '../data/reiseband-inhalt.html?raw';
import bandStil from '../data/reiseband-stil.css?raw';

/** Orte je Station, getrennt nach Zentrum und Ausflügen. */
const countsOf = (slug: string) => ({
  zentrum: places.filter((p) => p.station === slug && p.area === 'zentrum').length,
  ausflug: places.filter((p) => p.station === slug && p.area === 'ausflug').length,
});

/*
 * Hier stand `const kapitel` — `chapters.json`, angereichert mit Nächten, Datum
 * und Ortszahl je Station. Gebraucht hat es nur die Kapitelzeile über dem Band,
 * und die ist weg: Der Band bringt seine klebende Stationsleiste selbst mit.
 * Die Zuordnung Kapitel → Zahlen macht jetzt `stations.json` direkt im Abschnitt
 * „Die Route" weiter unten.
 */

/** Anker im Reiseband — vom Konvertierungsskript gesetzt. */
const chapterOf: Record<string, string> = {
  osaka: 'osaka',
  kyoto: 'kyoto',
  kanazawa: 'kanazawa',
  takayama: 'takayama',
  hakone: 'hakone',
  tokio: 'tokio',
};
---

<Base title="Übersicht">
  <!--
    Hier stand ein Hero-Block mit Titel, japanischem Schriftzug und dem großen
    旅. Er ist weg, weil der Band **seine eigene Titelseite** mitbringt — mit
    genau denselben Elementen, von dort hatte ich sie ursprünglich abgeschaut.
    Zweimal derselbe Deckel kostete 298 px, bevor überhaupt ein Satz kam.
  -->
  <TripStatus client:only="svelte" />

  <!--
    Der Reiseband, vollständig und direkt lesbar.

    Vorher stand hier eine Kachelliste, die man erst anklicken musste, um zum
    Text zu kommen — ein Umweg, für den es keinen Grund gab. Die 137 kB Text
    sind gzip-komprimiert etwa 59 kB; das ist weniger als ein einzelnes Foto,
    meine frühere Warnung davor war übertrieben.

    Hier stand bis zum 22.09.2026 eine schmale Kapitelzeile (`.bandsprung`) mit
    allen elf Kapitelnamen. Sie ist weg, weil der Band jetzt seine **eigene,
    klebende** Stationsleiste mitbringt — erzeugt in `build-data.mjs`, sechs
    Kanji-Chips, und sie bleibt beim Scrollen stehen. Das war der Mangel der
    alten Zeile: Bei 14.650 Wörtern ist „wie komme ich nach Hakone" keine Frage,
    die man einmal am Seitenanfang stellt.

    Die fünf Kapitel ohne Station (Einladung, Prolog, Route, Ankunft, Epilog)
    stehen nicht in der Leiste, behalten aber ihre Sprungmarke am `<details>` —
    `paths.ts:kapitel()` trifft sie weiter, und `browser-reiseband.mjs` prüft
    jede einzeln.
  -->
  <div class="bandtext" set:html={bandInhalt} />

  <!--
    Ein Ankersprung muss die Klappe öffnen.

    Der Band ist seit dem Umbau ein Akkordeon, und die Anker sitzen an den
    `<details>`. Ein Link wie `/Japan/#kyoto` aus `paths.ts:kapitel()` springt
    sonst an eine **zugeklappte** Zeile: Man landet richtig und sieht nichts, und
    hält den Link für kaputt. Das war der ursprüngliche Grund für dieses Skript;
    seit dem 22.09.2026 hängen zwei weitere Dinge daran, beide aus der gesendeten
    Vorlage: die Markierung in der klebenden Stationsleiste und der Knopf nach
    oben. Alle drei stehen hier und nicht im Bandtext, weil `set:html` keine
    Skripte ausführt.

    Zwei Fälle, beide nötig: beim Laden mit Anker (`hashchange` feuert dann
    nicht) und bei jedem Sprung danach. `scrollIntoView` erst **nach** dem
    Öffnen — vorher steht die Klappe noch an ihrer alten Höhe, und der Browser
    scrollt an die falsche Stelle.
  -->
  <script is:inline>
    (function () {
      function aufklappen() {
        var id = location.hash.slice(1);
        if (!id) return;
        var ziel = document.getElementById(id);
        if (!ziel) return;
        // Auch die Eltern öffnen: Ein Anker kann in einem Teilabschnitt liegen.
        var k = ziel;
        while (k) {
          if (k.tagName === 'DETAILS') k.open = true;
          k = k.parentElement;
        }
        ziel.scrollIntoView();
      }
      window.addEventListener('hashchange', aufklappen);
      aufklappen();

      /*
       * Die klebende Stationsleiste markiert, wo man liest.
       *
       * Die Logik ist aus der gesendeten Vorlage übernommen, ihre Fassung nicht:
       * Die greift ohne Prüfung auf `.m-top` zu (`btn.classList` wirft, wenn der
       * Knopf fehlt) und rechnet mit `offsetTop`, was bei einem `<details>` in
       * einem positionierten Vorfahren die falsche Zahl liefert. Hier wird
       * gegen den Viewport gemessen, und jeder Fund wird geprüft.
       *
       * Gemessen wird das **Kapitel**, nicht die Leiste: Ein zugeklapptes
       * `<details>` ist 48 px hoch, ein offenes mehrere Tausend. Der Chip soll
       * die Station nennen, in der der Text gerade steht — also die letzte, deren
       * Kopf oberhalb der Leiste durchgelaufen ist.
       */
      var chips = [].slice.call(document.querySelectorAll('.m-nav a'));
      if (chips.length) {
        var ziele = chips
          .map(function (a) {
            var id = (a.getAttribute('href') || '').slice(1);
            var el = id ? document.getElementById(id) : null;
            return el ? { chip: a, el: el } : null;
          })
          .filter(Boolean);

        // Die Höhe der Kopfleiste plus die der Leiste selbst: Darüber ist ein
        // Kapitel durchgelaufen, darunter steht es noch im Bild.
        function grenze() {
          var nav = document.querySelector('.m-nav');
          var r = nav ? nav.getBoundingClientRect() : null;
          return r ? r.bottom + 8 : 80;
        }

        function markiere() {
          var g = grenze();
          var treffer = null;
          ziele.forEach(function (z) {
            if (z.el.getBoundingClientRect().top <= g) treffer = z;
          });
          chips.forEach(function (a) {
            a.classList.toggle('on', !!treffer && treffer.chip === a);
          });
        }
        window.addEventListener('scroll', markiere, { passive: true });
        // Ein Auf- oder Zuklappen verschiebt alles darunter — ohne das zeigt die
        // Leiste nach dem ersten Tipp auf eine andere Station.
        document.addEventListener('toggle', markiere, true);
        markiere();
      }

      /*
       * Der Knopf nach oben. Er steht im erzeugten Bandtext (`NACH_OBEN` in
       * `build-data.mjs`), weil er zum Band gehört und nicht zur Seite — aber
       * `set:html` führt keine Skripte aus, deshalb hängt sein Verhalten hier.
       */
      var oben = document.querySelector('.m-top');
      if (oben) {
        var zeigen = function () {
          oben.classList.toggle('show', window.scrollY > 700);
        };
        window.addEventListener('scroll', zeigen, { passive: true });
        oben.addEventListener('click', function () {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
        zeigen();
      }
    })();
  </script>

  <p class="banddruck">
    <!--
      Steht hinter dem Text, nicht davor: Eine Fußnote, die 80 px Vorlauf kostet,
      bevor der erste Satz kommt, ist an der falschen Stelle.

      Die Datei reiseband.html bleibt ein geschlossenes Dokument zum Ausdrucken
      oder Weitergeben, mit den Seitenrändern, die hier wegfallen. Ohne diesen
      Verweis wäre sie von nirgends mehr erreichbar.
    -->
    Zum Ausdrucken oder Weitergeben:
    <a href={guide()}>der Band als eigenes Dokument</a>. Die sieben Empfehlungen
    ohne Nummer stehen nur darin und nicht auf der Karte — Gion ehrlich, Nijō-jō,
    Tsukiji-Außenmarkt, 21st Century Museum, Shinhotaka-Seilbahn, Igelcafé, Round1.
  </p>

  <!-- ------------------------------------------------------------ Stationen -->
  <section class="section">
    <div class="eyebrow">Die Route</div>
    <h2>Sechs Stationen, {trip.nights} Nächte</h2>

    <div class="stations">
      {
        stations.map((s) => {
          const c = countsOf(s.slug);
          return (
            <article class="station">
              <div class="sno">
                {s.no}
                <span class="skanji">{s.kanji}</span>
              </div>
              <div class="sbody">
                <h3>
                  {s.name} <span class="sjp">{s.jp}</span>
                </h3>
                <p class="sclaim">{s.claim}</p>
                <div class="sfacts">
                  <span class="badge">
                    <b>{s.nights}</b> {s.nights === 1 ? 'Nacht' : 'Nächte'}
                  </span>
                  <span class="badge">
                    {formatDay(s.from)} – {formatDay(s.to)}
                  </span>
                  <span class="badge">
                    <b>{c.zentrum}</b> im Zentrum
                  </span>
                  {c.ausflug > 0 && (
                    <span class="badge">
                      <b>{c.ausflug}</b> Ausflüge
                    </span>
                  )}
                </div>
                <p class="sstay">{s.stay}</p>
                <div class="slinks">
                  <a href={`${url('orte')}?station=${s.slug}`}>Orte ansehen</a>
                  <a href={`#${chapterOf[s.slug]}`}>Kapitel lesen</a>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <!--
    Das Stylesheet des Bandes, an `.bandtext` gebunden. Muss `is:global` sein:
    Astro bindet Stile sonst an Elemente, die es selbst erzeugt hat — der Inhalt
    kommt hier über `set:html` und wäre damit unformatiert.

    Gebunden wird beim Erzeugen (`scripts/css-scope.mjs`), nicht hier: Das CSS
    führt `:root`, `html`, `body`, `.eyebrow` und `.wrap`, und unverändert
    eingebunden würde es die ganze Anwendung umlackieren. `npm run data` bricht
    ab, wenn eine Regel ohne Container übrig bleibt.
  -->
  <style is:global set:html={bandStil}></style>

  <style>
    /* ------------------------------------------------------- Kapitelsprünge */

    /* --------------------------------------------------------- Der Bandtext */

    .banddruck {
      margin: 10px 0 22px;
      font-size: 0.78rem;
      line-height: 1.6;
      color: var(--ai-60);
    }
    .banddruck a {
      color: var(--shu);
    }

    .bandtext {
      /* Der Band bringt seine eigene Breite und Typografie mit; hier wird nur
         dafür gesorgt, dass er nicht aus der Seite läuft. */
      max-width: 100%;
      overflow-wrap: break-word;
    }
    /* Die Anker sitzen an den Kapiteln. Ohne Abstand verschwindet die
       Überschrift beim Sprung unter die feste Kopfzeile.

       `details[id]` und nicht mehr `section[id]`: Seit der Band ein Akkordeon
       ist, trägt die Klappe den Anker. Der alte Selektor blieb gültiges CSS und
       traf nichts — die Art Regel, die man erst bemerkt, wenn eine Überschrift
       unter der Kopfzeile steckt. */
    .bandtext :global(details[id]) {
      scroll-margin-top: 70px;
    }
    /* Hier stand der Scrollrahmen `.bandtabelle` um jede der 19 Tabellen. Er ist
       weg, weil es keine Tabellen mehr gibt: `tabellenZuKarten()` in
       `build-data.mjs` löst sie in gestapelte Wertzeilen auf. Der Rahmen war die
       Notlösung — Querscrollen in einem Kasten statt in der Seite —, die
       Auflösung ist die Behebung. */

    /* -------------------------------------------------------------- Abschnitte */

    .section {
      margin-top: 40px;
    }

    .section h2 {
      font-size: clamp(1.5rem, 3.8vw, 2rem);
      margin-bottom: 16px;
    }

    /* --------------------------------------------------------------- Stationen */

    .stations {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
      gap: 12px;
    }

    .station {
      display: flex;
      gap: 15px;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 15px 17px 16px;
    }

    .sno {
      font-family: var(--disp);
      font-weight: 700;
      font-size: 1.85rem;
      color: var(--shu);
      line-height: 1;
      flex: none;
      text-align: center;
    }

    .skanji {
      display: block;
      font-family: var(--jp);
      font-size: 1.05rem;
      color: var(--kin);
      margin-top: 6px;
      opacity: 0.85;
    }

    .sbody {
      min-width: 0;
      flex: 1;
    }

    .station h3 {
      font-size: 1.16rem;
      display: flex;
      align-items: baseline;
      gap: 8px;
      flex-wrap: wrap;
    }

    .sjp {
      font-family: var(--jp);
      font-size: 0.82rem;
      color: var(--shu-deep);
      letter-spacing: 0.14em;
    }

    .sclaim {
      font-style: italic;
      color: var(--ai-60);
      font-size: 0.9rem;
      margin: 2px 0 9px;
    }

    .sfacts {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      margin-bottom: 9px;
    }

    .sstay {
      font-family: var(--util);
      font-size: 0.74rem;
      color: var(--ai-40);
      margin: 0 0 9px;
      line-height: 1.45;
    }

    .slinks {
      display: flex;
      gap: 14px;
      font-family: var(--util);
      font-size: 0.74rem;
    }

    @media (max-width: 767px) {
      /* Die Stationslinks sind eigenständige Ziele, keine Fließtextlinks —
         auf dem Handy brauchen sie eine Fläche, die sich sicher treffen lässt. */
      .slinks {
        gap: 8px;
        margin-top: 4px;
      }
      .slinks a {
        flex: 1;
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--washi-2);
        border: 1px solid var(--line);
        border-radius: var(--radius-sm);
        padding: 0 10px;
        text-align: center;
      }
      .slinks a:hover {
        text-decoration: none;
      }

      .station {
        gap: 12px;
        padding: 14px 14px 15px;
      }}</style>
</Base>
