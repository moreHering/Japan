---
import Base from '../layouts/Base.astro';
import DayPlanner from '../components/DayPlanner.svelte';
import { places } from '../lib/places';
---

<Base
  title="Tagesplan"
  subtitle="Zwanzig Tage, 26.09. bis 15.10. Orte auf Tage legen, sortieren, Notizen dazu. Die Seite warnt, wenn ein Ort am geplanten Wochentag geschlossen ist."
>
  <DayPlanner client:only="svelte" places={places} />
</Base>
